<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: App Name & Dot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KANRI"
            android:textColor="#00B4D8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="• Daily Spend"
            android:textColor="#8B949E"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Today's Spend -->
    <TextView
        android:id="@+id/widget_spent_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="₹0"
        android:textColor="#F0F6FC"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_today_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Spent Today"
        android:textColor="#8B949E"
        android:textSize="11sp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="65"
        android:progressTint="#06D6A0" />

    <!-- Budget Status -->
    <TextView
        android:id="@+id/widget_budget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="₹0 Left • Safe: ₹0/day"
        android:textColor="#06D6A0"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#2E384D" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RECENT TRANSACTIONS"
        android:textColor="#8B949E"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Recent Transaction Row 1 -->
    <LinearLayout
        android:id="@+id/widget_tx1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tx1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="—"
            android:textColor="#E6EDF3"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_tx1_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FF7B72"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Recent Transaction Row 2 -->
    <LinearLayout
        android:id="@+id/widget_tx2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tx2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="—"
            android:textColor="#E6EDF3"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_tx2_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FF7B72"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Recent Transaction Row 3 -->
    <LinearLayout
        android:id="@+id/widget_tx3_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tx3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="—"
            android:textColor="#E6EDF3"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_tx3_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FF7B72"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/widget_no_tx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="No recent transactions"
        android:textColor="#8B949E"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
