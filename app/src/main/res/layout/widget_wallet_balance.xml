<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wallet_balance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/google_sans_bold"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:text="WALLETS &amp; BALANCES"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/widget_wallet_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_bold"
            android:textStyle="bold"
            android:text="Total: ₹0"
            android:textColor="#E0FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Balances Dual Columns -->
    <LinearLayout
        android:id="@+id/widget_wallet_columns_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Cash Wallet Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_bold"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:text="CASH"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_cash_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_bold"
                android:textStyle="bold"
                android:maxLines="1"
                android:text="₹0"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_cash_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_regular"
                android:maxLines="1"
                android:text="Physical cash"
                android:textColor="#80FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Subtle vertical divider -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#26FFFFFF" />

        <!-- Online / Bank Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_bold"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:text="ONLINE"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_online_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_bold"
                android:textStyle="bold"
                android:maxLines="1"
                android:text="₹0"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_online_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_regular"
                android:maxLines="1"
                android:text="Bank &amp; UPI"
                android:textColor="#80FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtitle / Footer -->
    <TextView
        android:id="@+id/widget_wallet_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/google_sans_medium"
        android:singleLine="true"
        android:text="Tap to manage wallets"
        android:textColor="#80FFFFFF"
        android:textSize="10sp" />

</LinearLayout>
