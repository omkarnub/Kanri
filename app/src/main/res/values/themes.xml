<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default theme is DARK for Kanri -->
    <style name="Theme.Kanri" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background_dark</item>
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/panchang_light</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#000000</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Light theme for MainActivityLight -->
    <style name="Theme.Kanri.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background_light</item>
        <item name="android:windowSplashScreenBackground">#FEFAEC</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/panchang_dark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FEFAEC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>