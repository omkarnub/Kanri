<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude encrypted/plain databases, keystore-backed prefs, crash logs, and exports from cloud auto-backup (CWE-459) -->
    <exclude domain="database" path="kanri_database" />
    <exclude domain="database" path="kanri_database-wal" />
    <exclude domain="database" path="kanri_database-shm" />
    <exclude domain="database" path="kanri_database_plain.db" />
    <exclude domain="sharedpref" path="kanri_secure_db_prefs.xml" />
    <exclude domain="sharedpref" path="kanri_cloud_backup_secure_prefs.xml" />
    <exclude domain="file" path="auto_exports" />
    <exclude domain="file" path="crash_logs" />
</full-backup-content>