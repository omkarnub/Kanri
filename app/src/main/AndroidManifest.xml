<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".KanriApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kanri">
        <!-- 1. Dark Icon + Dark Splash (for Dark Theme) -->
        <activity
            android:name=".MainActivityDarkDark"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kanri"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:taskAffinity="com.omkarnub.kanri.dark.dark"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 2. Dark Icon + Light Splash (for Light Theme) -->
        <activity
            android:name=".MainActivityDarkLight"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kanri.Light"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:taskAffinity="com.omkarnub.kanri.dark.light"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 3. Light Icon + Dark Splash (for Dark Theme) -->
        <activity
            android:name=".MainActivityLightDark"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kanri"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:taskAffinity="com.omkarnub.kanri.light.dark"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 4. Light Icon + Light Splash (for Light Theme) -->
        <activity
            android:name=".MainActivityLightLight"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kanri.Light"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:taskAffinity="com.omkarnub.kanri.light.light"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>



        <service
            android:name=".ui.popup.InstantPopupService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Instant transaction popup overlay" />
        </service>

        <receiver
            android:name=".ui.popup.InstantPopupReceiver"
            android:exported="false" />

        <service
            android:name=".ui.notification.KanriNotificationListenerService"
            android:exported="true"
            android:label="Kanri Payment Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Bulletproof SMS Receiver for Money Sent & Received (Priority 999) -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Boot Completed Receiver to ensure watchdog and background schedulers survive phone reboot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Tile -->
        <service
            android:name=".service.QuickAddTileService"
            android:label="@string/quick_add_tile_label"
            android:icon="@drawable/ic_widget_add"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>


        <!-- 1. Budget Ring Chart Widget -->
        <receiver
            android:name=".widget.BudgetRingWidgetProvider"
            android:label="@string/widget_budget_ring_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_budget_ring_info" />
        </receiver>

        <!-- 2. Budget Progress Bar Widget -->
        <receiver
            android:name=".widget.BudgetProgressWidgetProvider"
            android:label="@string/widget_budget_progress_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_budget_progress_info" />
        </receiver>

        <!-- 3. Lend and Borrow Dues Widget -->
        <receiver
            android:name=".widget.LendBorrowWidgetProvider"
            android:label="@string/widget_lend_borrow_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lend_borrow_info" />
        </receiver>

        <!-- 4. Savings Goals Ring Widget -->
        <receiver
            android:name=".widget.GoalsRingWidgetProvider"
            android:label="@string/widget_goals_ring_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_goals_ring_info" />
        </receiver>

        <!-- 5. Split The Bill Widget -->
        <receiver
            android:name=".widget.SplitBillWidgetProvider"
            android:label="@string/widget_split_bill_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_split_bill_info" />
        </receiver>

        <!-- 6. Quick Add Expense and Income Widget -->
        <receiver
            android:name=".widget.QuickAddWidgetProvider"
            android:label="@string/widget_quick_add_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add_info" />
        </receiver>

        <!-- 7. Money Spent Today Widget -->
        <receiver
            android:name=".widget.MoneySpentTodayWidgetProvider"
            android:label="@string/widget_spent_today_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spent_today_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>