<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".KanriApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kanri.Starting">
        <!-- 1. Dark Icon + Dark Splash (for Dark Theme) -->
        <activity
            android:name=".MainActivityDarkDark"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kanri.Starting"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:taskAffinity="com.omkarnub.kanri.dark.dark"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.omkarnub.kanri.action.ADD_EXPENSE" />
                <action android:name="com.omkarnub.kanri.action.ADD_INCOME" />
                <action android:name="com.omkarnub.kanri.action.SPLIT_BILL" />
                <action android:name="com.omkarnub.kanri.action.OPEN_LENDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 2. Dark Icon + Light Splash (for Light Theme) -->
        <activity
            android:name=".MainActivityDarkLight"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kanri.Starting.Light"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:taskAffinity="com.omkarnub.kanri.dark.light"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.omkarnub.kanri.action.ADD_EXPENSE" />
                <action android:name="com.omkarnub.kanri.action.ADD_INCOME" />
                <action android:name="com.omkarnub.kanri.action.SPLIT_BILL" />
                <action android:name="com.omkarnub.kanri.action.OPEN_LENDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 3. Light Icon + Dark Splash (for Dark Theme) -->
        <activity
            android:name=".MainActivityLightDark"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kanri.Starting"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:taskAffinity="com.omkarnub.kanri.light.dark"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.omkarnub.kanri.action.ADD_EXPENSE" />
                <action android:name="com.omkarnub.kanri.action.ADD_INCOME" />
                <action android:name="com.omkarnub.kanri.action.SPLIT_BILL" />
                <action android:name="com.omkarnub.kanri.action.OPEN_LENDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 4. Light Icon + Light Splash (for Light Theme) -->
        <activity
            android:name=".MainActivityLightLight"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kanri.Starting.Light"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:taskAffinity="com.omkarnub.kanri.light.light"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.omkarnub.kanri.action.ADD_EXPENSE" />
                <action android:name="com.omkarnub.kanri.action.ADD_INCOME" />
                <action android:name="com.omkarnub.kanri.action.SPLIT_BILL" />
                <action android:name="com.omkarnub.kanri.action.OPEN_LENDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Quick Manual Entry Dialog Activity (Floating numpad directly on home screen) -->
        <activity
            android:name=".ui.quickentry.QuickEntryActivity"
            android:exported="true"
            android:theme="@style/Theme.Kanri.QuickEntry"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.omkarnub.kanri.action.ADD_EXPENSE" />
                <action android:name="com.omkarnub.kanri.action.ADD_INCOME" />
                <action android:name="com.omkarnub.kanri.action.SPLIT_BILL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.popup.InstantPopupService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Instant transaction popup overlay" />
        </service>

        <receiver
            android:name=".ui.popup.InstantPopupReceiver"
            android:exported="false" />

        <service
            android:name=".ui.notification.KanriNotificationListenerService"
            android:exported="true"
            android:label="Kanri Payment Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Bulletproof SMS Receiver for Money Sent & Received (Priority 999) -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Boot Completed Receiver to ensure watchdog and background schedulers survive phone reboot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Tile -->
        <service
            android:name=".service.QuickAddTileService"
            android:label="@string/quick_add_tile_label"
            android:icon="@drawable/ic_quick_add_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>


        <!-- 1. Today Spend Widget -->
        <receiver
            android:name=".widget.providers.TodayWidgetProvider"
            android:label="@string/widget_today_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- 2. Budget Widget -->
        <receiver
            android:name=".widget.providers.BudgetWidgetProvider"
            android:label="@string/widget_budget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_budget_info" />
        </receiver>

        <!-- 3. Wallets Widget -->
        <receiver
            android:name=".widget.providers.WalletsWidgetProvider"
            android:label="@string/widget_wallets_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wallets_info" />
        </receiver>

        <!-- 4. Goals Widget -->
        <receiver
            android:name=".widget.providers.GoalsWidgetProvider"
            android:label="@string/widget_goals_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_goals_info" />
        </receiver>

        <!-- 5. Dues Widget -->
        <receiver
            android:name=".widget.providers.DuesWidgetProvider"
            android:label="@string/widget_dues_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dues_info" />
        </receiver>

        <!-- 6. Sky Widget -->
        <receiver
            android:name=".widget.providers.SkyWidgetProvider"
            android:label="@string/widget_sky_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sky_info" />
        </receiver>

        <!-- 7. Month Heatmap Widget -->
        <receiver
            android:name=".widget.providers.HeatmapWidgetProvider"
            android:label="@string/widget_heatmap_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_heatmap_info" />
        </receiver>

        <!-- 8. No-Spend Streak Widget -->
        <receiver
            android:name=".widget.providers.StreakWidgetProvider"
            android:label="@string/widget_streak_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>

        <!-- 9. Safe to Spend Widget -->
        <receiver
            android:name=".widget.providers.SafeToSpendWidgetProvider"
            android:label="@string/widget_safe_to_spend_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_safe_to_spend_info" />
        </receiver>

        <!-- 10. Review Inbox Widget -->
        <receiver
            android:name=".widget.providers.ReviewInboxWidgetProvider"
            android:label="@string/widget_review_inbox_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_review_inbox_info" />
        </receiver>

        <!-- 11. Month Delta Widget -->
        <receiver
            android:name=".widget.providers.MonthDeltaWidgetProvider"
            android:label="@string/widget_month_delta_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_delta_info" />
        </receiver>

        <!-- 12. Quick Actions Widget -->
        <receiver
            android:name=".widget.providers.QuickActionsWidgetProvider"
            android:label="@string/widget_quick_actions_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>